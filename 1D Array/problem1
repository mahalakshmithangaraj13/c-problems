#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int max=arr[0],second_max=arr[0];
    for(int j=0;j<n;j++){
        if(arr[j]>max){
            second_max=max;
            max=arr[j];    
        }
        else if(arr[j]>second_max && second_max<max){
            second_max=arr[j];
        }
    }
    printf("%d",second_max);
    return 0;
}
